# Qdrant (docker-compose exposes it on localhost:6333)
QDRANT_URL=http://localhost:6333

# OpenAI-compatible LLM (DeepSeek is the default)
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional tuning
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
CHUNK_SIZE=800
CHUNK_OVERLAP=120
